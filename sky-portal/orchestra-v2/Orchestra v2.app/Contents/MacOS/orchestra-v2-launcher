#!/bin/zsh
set -euo pipefail

APP_DIR="$(cd "$(dirname "$0")" && pwd)"
ORCHESTRA_DIR="$(cd "$APP_DIR/../../.." && pwd)"

HOST="${ORCHESTRA_HOST:-0.0.0.0}"
PORT="${ORCHESTRA_PORT:-8420}"
LOCAL_URL="http://127.0.0.1:${PORT}"
STATE_URL="${LOCAL_URL}/api/state"
RUNTIME_DIR="${ORCHESTRA_DIR}/.orchestra-v2"
PID_FILE="${RUNTIME_DIR}/server.pid"
LOG_FILE="${RUNTIME_DIR}/launcher.log"

mkdir -p "$RUNTIME_DIR"

notify() {
  /usr/bin/osascript -e "display notification \"$1\" with title \"Orchestra v2\"" >/dev/null 2>&1 || true
}

alert() {
  /usr/bin/osascript -e "display dialog \"$1\" buttons {\"OK\"} default button \"OK\" with title \"Orchestra v2\"" >/dev/null 2>&1 || true
}

is_dashboard_alive() {
  /usr/bin/curl -fsS --max-time 2 "$STATE_URL" >/dev/null 2>&1
}

if [ ! -f "${ORCHESTRA_DIR}/orchestrator_v2.py" ]; then
  alert "Cannot find orchestrator_v2.py. Keep this app inside the orchestra-v2 folder."
  exit 1
fi

if is_dashboard_alive; then
  /usr/bin/open "$LOCAL_URL"
  notify "Orchestra v2 is already running."
  exit 0
fi

if [ -f "$PID_FILE" ]; then
  OLD_PID="$(cat "$PID_FILE" 2>/dev/null || true)"
  if [ -n "$OLD_PID" ] && /bin/kill -0 "$OLD_PID" >/dev/null 2>&1; then
    sleep 2
    if is_dashboard_alive; then
      /usr/bin/open "$LOCAL_URL"
      notify "Orchestra v2 is running."
      exit 0
    fi
  fi
fi

PYTHON_BIN="$(command -v python3 || true)"
if [ -z "$PYTHON_BIN" ]; then
  alert "Python 3 was not found. Install Python 3, then open Orchestra v2 again."
  exit 1
fi

{
  echo ""
  echo "[$(/bin/date)] Starting Orchestra v2"
  echo "Directory: $ORCHESTRA_DIR"
  echo "URL: $LOCAL_URL"
} >> "$LOG_FILE"

cd "$ORCHESTRA_DIR"
nohup "$PYTHON_BIN" "$ORCHESTRA_DIR/orchestrator_v2.py" --host "$HOST" --port "$PORT" >> "$LOG_FILE" 2>&1 &
echo "$!" > "$PID_FILE"

for _ in {1..30}; do
  if is_dashboard_alive; then
    /usr/bin/open "$LOCAL_URL"
    notify "Orchestra v2 is ready."
    exit 0
  fi
  sleep 0.5
done

/usr/bin/open -a TextEdit "$LOG_FILE" >/dev/null 2>&1 || true
alert "Orchestra v2 did not start. I opened the log file so you can inspect the error."
exit 1
